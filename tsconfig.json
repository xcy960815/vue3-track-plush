{
  "compilerOptions": {
    "isolatedModules": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "removeComments": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "noLib": false,
    "target": "ES2015",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@plugin/*": [
        "./plugin/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "./temp",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "./temp",
    "dist"
  ],
  "files": [
    "plugin/index.ts",
    "plugin/core/event.ts",
    "plugin/core/exposure-queue.ts",
    "plugin/core/tracker.ts",
    "plugin/directive/browse.ts",
    "plugin/directive/cleanup.ts",
    "plugin/directive/click.ts",
    "plugin/directive/exposure.ts",
    "plugin/directive/index.ts",
    "plugin/type.ts",
    "plugin/transport/index.ts",
    "plugin/utils/params.ts",
    "src/shims-vue.d.ts"
  ]
}
