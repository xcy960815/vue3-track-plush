{
  "name": "vue3-track-plush",
  "description": "基于vue3自定义指令的埋点统计",
  "version": "0.1.4",
  "license": "MIT",
  "private": false,
  "main": "dist/vue3-track-plush.umd.js",
  "module": "dist/vue3-track-plush.esm.js",
  "types": "types/vue3-track-plush.d.ts",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "dev:plugin": "vite build --config vite.plugin.config.ts --watch",
    "build": "pnpm build:plugin",
    "build:plugin": "run-s clean:temp build:plugin:js build:plugin:types clean:temp",
    "build:plugin:js": "vite build --config vite.plugin.config.ts",
    "build:plugin:types": "tsc -p tsconfig.plugin.json && rollup -c rollup.dts.config.mjs",
    "clean:temp": "rm -rf ./temp",
    "link": "npm link && npm link vue3-track-plush",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue-track",
    "vue3-track-plush",
    "vue3",
    "track"
  ],
  "author": {
    "name": "xuchongyu",
    "email": "18763006837@163.com"
  },
  "peerDependencies": {
    "vue": "^3.2.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.7",
    "less": "^4.1.3",
    "npm-run-all2": "^9.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vue": "^3.2.13",
    "vue-tsc": "^3.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "vue-router": "^4.6.4"
  }
}
